<div class="animation-box">

    <h3>Area of Triangle Animation</h3>

    <svg viewBox="0 0 500 350">

        <polygon points="100,250 400,250 250,80"
                 fill="none"
                 stroke="#222"
                 stroke-width="4" />

        <line id="triangleBase"
              x1="100"
              y1="250"
              x2="100"
              y2="250"
              stroke="#007bff"
              stroke-width="6" />

        <line id="triangleHeight"
              x1="250"
              y1="80"
              x2="250"
              y2="80"
              stroke="#e74c3c"
              stroke-width="6" />

       <text x="220" y="290" fill="black">
    Base / आधार
</text>

<text x="260" y="170" fill="black">
    Height / ऊँचाई
</text>

    </svg>

    <br />

    <button type="button" onclick="animateTriangle()">
        Show Base & Height
    </button>

</div>

<script>

function animateTriangle() {

    const base = document.getElementById("triangleBase");
    const height = document.getElementById("triangleHeight");

    if (!base || !height) return;

    let progress = 0;

    function animate() {

        progress += 0.02;

        if (progress > 1)
            progress = 1;

        const baseX = 100 + (300 * progress);
        const heightY = 80 + (170 * progress);

        base.setAttribute("x2", baseX);
        height.setAttribute("y2", heightY);

        if (progress < 1)
            requestAnimationFrame(animate);
    }

    animate();
}

</script>